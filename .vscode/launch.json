{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Duma3D (MinGW/GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Duma3D.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build Duma3D",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Program Files/CodeBlocks/MinGW/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
